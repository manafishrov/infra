--- /dev/null
+++ b/tofu/stalwart/dns.tf
@@ -0,0 +1,14 @@
+# The credential is supplied to the backend process, not the OpenTofu runner.
+resource "stalwart_dns_server_cloudflare" "dkim" {
+  description = "Manafish DKIM publication only"
+  secret = {
+    type          = "EnvironmentVariable"
+    variable_name = "STALWART_CLOUDFLARE_DKIM_TOKEN"
+  }
+  # Native Duration values are milliseconds.
+  ttl                 = 300000
+  timeout             = 30000
+  polling_interval    = 2000
+  propagation_delay   = 1000
+  propagation_timeout = 120000
+}
