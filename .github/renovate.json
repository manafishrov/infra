{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "abandonments:recommended",
    ":maintainLockFilesWeekly",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Oslo",
  "schedule": ["before 09:00 on monday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps): ",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "nix": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": ["/apps/.+\\.ya?ml$/"]
  },
  "helmv3": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": ["/apps/.+\\.ya?ml$/"]
  },
  "terraform": {
    "managerFilePatterns": ["/^tofu/.+\\.tf$/"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 09:00 on monday"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupName": "container & action digests",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor dependencies"
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "lock file maintenance",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake updates",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["helmv3", "flux"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"],
      "automerge": false
    },
    {
      "description": "Keep Pocket ID compatible with trozz/pocketid 2.5.0: 2.19 renames required application config fields the provider still sends. Lift after a provider release models the new fields.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/pocket-id/pocket-id"],
      "allowedVersions": "<2.19.0"
    },
    {
      "description": "Follow n8n's stable line. Numeric 2.45 Docker tags are GitHub prereleases; raise once n8n moves its stable tag to 2.45.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/n8nio/n8n"],
      "allowedVersions": "<2.45.0"
    },
    {
      "enabled": false,
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "matchPackageNames": ["hashicorp/terraform"]
    }
  ]
}
